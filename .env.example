# Copy this file to .env and fill in the values. .env is gitignored and must never be committed.
# Each key is read once at startup through os.environ. The app never prints or logs a key.

# Alpaca. Paper-trading keys serve the free (Basic) market-data plan. Same variable names
# as the trading-bot repo on purpose, so the two lines copy straight across.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Finnhub (used from Phase 2). Free account at https://finnhub.io/register; the key is on the dashboard.
FINNHUB_API_KEY=

# FRED (VIX close and 10-year yield). Free account at https://fred.stlouisfed.org,
# then My Account > API Keys > Request API key.
FRED_API_KEY=

# SEC EDGAR (used from Phase 2). Not a key: the SEC requires an app name and a contact
# email in every request's User-Agent header. Put your real email here.
EDGAR_USER_AGENT=stock-terminal your.email@example.com
